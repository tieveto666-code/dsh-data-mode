{
  "name": "dsh-data-mode",
  "version": "0.1.0",
  "description": "DSH 数据模式插件：在原版 DeepSeek Harness 上增加只读问数。连接数据库或上传 CSV/Excel，用自然语言查数。不改标准/PTC/极简/创造。",
  "type": "module",
  "license": "MIT",
  "author": "Changsheng Tie (tieveto666-code)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tieveto666-code/dsh-data-mode.git"
  },
  "bugs": {
    "url": "https://github.com/tieveto666-code/dsh-data-mode/issues"
  },
  "homepage": "https://github.com/tieveto666-code/dsh-data-mode#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./data-source": "./lib/data-source.mjs",
    "./provider-duckdb": "./lib/provider-duckdb.mjs",
    "./tool-data": "./lib/tool-data.mjs",
    "./guard": "./lib/guard.mjs",
    "./context": "./lib/context.mjs",
    "./catalog-reader": "./lib/catalog-reader.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "lib",
    "preset",
    "examples",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "pack:release": "npm pack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "duckdb": "^1.4.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
